char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
null ::= "null"
root ::= "{" space root-thinking-kv ( "," space ( root-answer-kv root-answer-rest | root-toolcalls-kv ) )? space "}"
root-answer ::= (root-answer-0 | root-answer-1)
root-answer-0 ::= string
root-answer-1 ::= null
root-answer-kv ::= "\"answer\"" space ":" space root-answer
root-answer-rest ::= ( "," space root-toolcalls-kv )?
root-thinking ::= string
root-thinking-kv ::= "\"thinking\"" space ":" space root-thinking
root-toolcalls ::= (root-toolcalls-0 | root-toolcalls-1)
root-toolcalls-0 ::= "[" space (root-toolcalls-0-item ("," space root-toolcalls-0-item)*)? space "]"
root-toolcalls-0-item ::= "{" space root-toolcalls-0-item-name-kv "," space root-toolcalls-0-item-args-kv space "}"
root-toolcalls-0-item-args ::= "{" space  (root-toolcalls-0-item-args-additional-kv ( "," space root-toolcalls-0-item-args-additional-kv )* )? space "}"
root-toolcalls-0-item-args-additional-kv ::= string ":" space root-toolcalls-0-item-args-additional-value
root-toolcalls-0-item-args-additional-value ::= string
root-toolcalls-0-item-args-kv ::= "\"args\"" space ":" space root-toolcalls-0-item-args
root-toolcalls-0-item-name ::= string
root-toolcalls-0-item-name-kv ::= "\"name\"" space ":" space root-toolcalls-0-item-name
root-toolcalls-1 ::= null
root-toolcalls-kv ::= "\"toolcalls\"" space ":" space root-toolcalls
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
